# Copie para .env.development.local (dev) ou configure no servidor (produção).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor. Usada para criar usuários e redefinir senhas (API de admin).
SUPABASE_SECRET_KEY=
# Domínio interno dos usuários sem e-mail (login "ana.s" vira "ana.s@<domínio>").
USUARIOS_DOMINIO_INTERNO=usuarios.cristinas.invalid
# Endereço público do sistema, usado nos links de senha mandados pelo WhatsApp. Obrigatório em produção
# (em dev, sem ele, o link usa o endereço da própria requisição).
APP_URL=http://127.0.0.1:3100
