{
  "name": "cristinas",
  "version": "0.11.1",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/testar.mjs run",
    "test:unit": "vitest run tests/unit",
    "test:rls": "vitest run tests/rls",
    "e2e": "playwright test --project=regressao",
    "smoke": "playwright test --project=smoke",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/database.types.ts",
    "paridade": "tsx scripts/paridade-legado.ts",
    "roadmap": "tsx scripts/gerar-roadmap.ts"
  },
  "dependencies": {
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "1.59.0",
    "next": "16.4.3",
    "pdfkit": "^0.20.2",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pg": "^8.20.0",
    "playwright": "^1.62.1",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
